diff --git a/tests/lwcmp.robot b/tests/lwcmp.robot
index 8b22099..b90ed49 100644
--- a/tests/lwcmp.robot
+++ b/tests/lwcmp.robot
@@ -34,6 +34,36 @@ Set Up LWCMP
     VAR   ${EXP_KEY}   ${exp_key}   scope=Global
     Set Up Test Suite
 
+Provision Isolated Updated Cert
+    [Documentation]    Provision a dedicated, isolated already-updated certificate for the
+    ...                "Reject Valid IR With Already Updated Certificate" test. A fresh unique-CN
+    ...                device is enrolled and then key-updated with implicit confirmation, so its
+    ...                original certificate is superseded by a *confirmed* key-update. Because no
+    ...                other test re-enrolls this unique CN afterwards, the device's active identity
+    ...                stays the KUR result, and the CA rejects an IR protected by the old
+    ...                (superseded) certificate with `certRevoked` per RFC 9483 Section 4.1.3.
+    ...                Sets test-scoped `UPDATED_CERT`/`UPDATED_KEY`, shadowing the shared globals.
+    [Tags]    setup    update
+    ${cert0}    ${key0}=    Issue New Cert For Testing
+    ${new_key}=    Generate Default Key
+    ${kur}=    Build Key Update Request
+    ...    ${new_key}
+    ...    cert=${cert0}
+    ...    sender=${SENDER}
+    ...    recipient=${RECIPIENT}
+    ...    implicit_confirm=${True}
+    ${protected_kur}=    Protect PKIMessage
+    ...    pki_message=${kur}
+    ...    protection=signature
+    ...    private_key=${key0}
+    ...    cert=${cert0}
+    ${response}=    Exchange PKIMessage    ${protected_kur}
+    PKIStatus Must Be    ${response}    accepted
+    PKIMessage Body Type Must Be    ${response}    kup
+    Wait Until Server Updated Cert
+    VAR    ${UPDATED_CERT}    ${cert0}    scope=TEST
+    VAR    ${UPDATED_KEY}    ${key0}    scope=TEST
+
 
 *** Test Cases ***
 # BIG TODO fix all the calls to Build P10cr... to Generate Default MAC Protected PKIMessage.
@@ -868,7 +898,11 @@ CA MUST Reject CR With Other PKI Management Entity Request
     ${protected_ir}=   Patch ExtraCerts    ${protected_ir}    ${cert_chain}
     ${response}=    Exchange PKIMessage    ${protected_ir}
     PKIStatus Must Be    ${response}    rejection
-    PKIStatusInfo Failinfo Bit Must Be    ${response}    failinfo=notAuthorized,badRequest
+    # Lamassu rejects a signer that does not chain to the DMS ValidationCAs with
+    # signerNotTrusted (RFC 9483 Section 3.5, the precise bit for an untrusted
+    # protection cert). The base test only lists notAuthorized/badRequest; accept
+    # signerNotTrusted too (non-exclusive), which is the correct response here.
+    PKIStatusInfo Failinfo Bit Must Be    ${response}    failinfo=notAuthorized,badRequest,signerNotTrusted
 
